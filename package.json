{
  "name": "monion",
  "private": true,
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/api",
    "apps/dashboard",
    "packages/contracts",
    "infra/mock-university"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @monion/api",
    "dev:dashboard": "npm run dev --workspace @monion/dashboard",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @monion/api",
    "verify": "bash scripts/verify.sh",
    "contracts:check": "npm run check --workspace @monion/contracts",
    "db:generate": "npm run prisma:generate --workspace @monion/api",
    "db:deploy": "npm run prisma:deploy --workspace @monion/api",
    "db:check": "npm run prisma:check --workspace @monion/api"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.72.1"
  }
}
